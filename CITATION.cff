cff-version: 1.2.0
message: "Please cite the paper associated with the result directory you use."
title: "Formal Verification Artifacts for Unrestricted Boolean Multiplicative Complexity of Binary Polynomial Multiplication"
type: software
license: MIT
authors:
  - family-names: Morse
    given-names: Gregory
    affiliation: "Eotvos Lorand University"
repository-code: "https://github.com/GregoryMorse/unrestricted-boolean-mul"
abstract: >-
  Formal Lean proofs and computational verification artifacts for exact
  unrestricted XOR--AND multiplicative-complexity results for binary
  polynomial multiplication. Exact results are formalized through n = 4. The
  n = 5 unrestricted value 13 remains a candidate, with a checked upper
  circuit and proved quadratic-capacity results. Separate n = 6 workflows
  check upper witnesses and conditional bilinear reductions, not complete
  Lean lower bounds. The default build is the published n = 4 proof.
preferred-citation:
  type: article
  title: "Unrestricted Boolean Multiplicative Complexity of Four-Term Binary Polynomial Multiplication: Rational Places, Hasse Jets, and the Failure of Nonlinear Feedback"
  authors:
    - family-names: Morse
      given-names: Gregory
  year: 2026
  url: "https://arxiv.org/abs/2608.30238v1"
